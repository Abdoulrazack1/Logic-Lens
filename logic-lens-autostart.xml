<?xml version="1.0" encoding="UTF-16"?>
<Task version="1.2" xmlns="http://schemas.microsoft.com/windows/2004/02/mit/task">
  <RegistrationInfo>
    <Description>Redémarre automatiquement l'entraînement Logic-Lens au démarrage de Windows</Description>
    <Author>Logic-Lens</Author>
  </RegistrationInfo>
  <Triggers>
    <BootTrigger>
      <!-- Attend 30 secondes après le démarrage pour que Windows soit prêt -->
      <Delay>PT30S</Delay>
      <Enabled>true</Enabled>
    </BootTrigger>
  </Triggers>
  <Principals>
    <Principal id="Author">
      <LogonType>InteractiveToken</LogonType>
      <RunLevel>LeastPrivilege</RunLevel>
    </Principal>
  </Principals>
  <Settings>
    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>
    <DisallowStartIfOnBatteries>false</DisallowStartIfOnBatteries>
    <StopIfGoingOnBatteries>false</StopIfGoingOnBatteries>
    <ExecutionTimeLimit>PT0S</ExecutionTimeLimit>
    <Priority>7</Priority>
  </Settings>
  <Actions Context="Author">
    <Exec>
      <!-- IMPORTANT : remplacez C:\laragon\www\ll2 par votre chemin si différent -->
      <Command>node</Command>
      <Arguments>src\train.js --epochs 1000</Arguments>
      <WorkingDirectory>C:\laragon\www\ll2</WorkingDirectory>
    </Exec>
  </Actions>
</Task>
